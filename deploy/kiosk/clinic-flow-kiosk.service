[Unit]
Description=Clinic Flow dedicated Chromium kiosk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/clinic-flow/kiosk.env
ExecStart=/usr/bin/python3 %h/.local/lib/clinic-flow/kiosk_supervisor.py
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077
KillMode=control-group

[Install]
WantedBy=graphical-session.target
