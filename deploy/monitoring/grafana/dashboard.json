{
  "title": "Clinic Flow — pilot metrics",
  "uid": "clinic-flow-pilot",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Database reachable",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "clinic_db_up",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "id": 2,
      "title": "Online devices",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "clinic_devices_online",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "id": 3,
      "title": "Open MIS conflicts",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "clinic_mis_conflicts",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "id": 4,
      "title": "Tickets by state",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "clinic_tickets",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "MIS outbox by state",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "clinic_mis_outbox",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "HTTP p95 to response headers (s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le,family)(rate(clinic_http_response_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{family}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "HTTP responses / sec",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (family,status)(rate(clinic_http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{family}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    }
  ]
}
