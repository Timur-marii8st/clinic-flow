CLINIC_DB_PATH=data/clinic.sqlite3
# Только локальное демо. Не использовать общий пароль в production.
CLINIC_STAFF_PASSWORD=
# Для compose.postgres.yaml укажите свой локальный пароль:
# CLINIC_POSTGRES_PASSWORD=
# Для прямого подключения Python (не публикуйте URL/пароль в Git):
# CLINIC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/clinic
# Secure profile, compose.secure.yaml (all values must be explicitly set):
# CLINIC_MODE=secure
# CLINIC_PUBLIC_ORIGIN=https://localhost:8443
# CLINIC_OIDC_ISSUER=https://idp.example/realms/clinic
# CLINIC_OIDC_CLIENT_ID=clinic-flow
# CLINIC_OIDC_CLIENT_SECRET=
# CLINIC_BOOTSTRAP_SUBJECT=
# CLINIC_TLS_DIR=./local-tls
